7.25

bailA:
python3 main.py \
  --DS bailA \
  --source-domain bailA_2 \
  --target-domain bailA_1 \
  --hidden-dim 64 \
  --num-gc-layers 3 \
  --lr 0.001 \
  --conv_type GCN \
  --source-epochs 100 \
  --tta_epoch 50 \
  --seeds 1,2,3,4,5 \
  --output-dir results/bailA_GALA


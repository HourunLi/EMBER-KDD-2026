  --target_domain='syn-1' \
  --checkpoint='checkpoints/sfg_syn-2.pt' \
  --summary_output='logs/syn-2_to_syn-1_five_seeds.json' \
  --encoder='SAGE' \
  --hidden=16 \
  --K=10 \
  --d_epochs=5 \
  --g_epochs=10 \
  --c_epochs=5 \
  --c_lr=0.001 \
